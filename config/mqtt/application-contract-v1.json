      "canonicalState": [
        "ON",
        "OFF"
      ]
    },
    "boolean_set": {
      "accepted": [
        "1",
        "0",
        "TRUE",
        "FALSE"
      ],
      "canonicalPublish": [
        "1",
        "0"
      ]
    },
    "number": {
